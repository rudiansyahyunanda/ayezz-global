// PRISMA SCHEMA FOR SUPABASE POSTGRESQL DATABASE
// Project: AYEZZ GLOBAL SUBLIMATION WEB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. KATEGORI UTAMA (Categories)
model Category {
  id            String        @id @default(cuid())
  code          String
  title         String
  itemCount     String        @default("0 Jenis") @map("item_count")
  thumbnail     String?
  subCategories SubCategory[]
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("categories")
}

// 2. SUB-KATEGORI (SubCategories Datatable Model)
model SubCategory {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  code        String
  title       String
  description String?
  thumbnail   String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("sub_categories")
}

// 3. JENIS POTONGAN / KOLAR (Cut Types with 1:1 Thumbnail)
model CutType {
  id          String   @id @default(cuid())
  name        String
  addOnPrice  Decimal  @default(0.00) @map("add_on_price") @db.Decimal(10, 2)
  description String?
  thumbnail   String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cut_types")
}

// 4. JENIS KAIN SUBLIMASI (Fabric Materials with GSM, Features & 1:1 Thumbnail)
model FabricType {
  id          String   @id @default(cuid())
  name        String
  basePrice   Decimal  @default(70.00) @map("base_price") @db.Decimal(10, 2)
  tier        String   @default("Premium")
  gsm         String?  @default("150 GSM")
  features    String?
  description String?
  thumbnail   String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("fabric_types")
}

// 5. TEMPLATE REKA BENTUK (Design Templates with Multi-Photo Gallery)
model DesignTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String
  subCategory String?  @map("sub_category")
  description String?
  thumbnail   String?
  images      Json?    @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("design_templates")
}

// 6. REKOD PESANAN (Orders Log)
model Order {
  id             String   @id @default(cuid())
  clientName     String   @map("client_name")
  templateName   String?  @map("template_name")
  cutType        String?  @map("cut_type")
  fabricMaterial String?  @map("fabric_material")
  sizeBreakdown  Json?    @map("size_breakdown")
  totalQty       Int      @default(1) @map("total_qty")
  unitPrice      Decimal? @map("unit_price") @db.Decimal(10, 2)
  totalPrice     Decimal? @map("total_price") @db.Decimal(10, 2)
  status         String   @default("Menunggu WhatsApp")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("orders")
}
